{
  "version": 1,
  "chat": {
    "protected_branches": ["main", "production"],
    "production_branch": "production"
  },
  "bootstrap": {
    "install": ["npm ci"]
  },
  "ci": {
    "default_branch": "main",
    "node_version": "22",
    "profile": "profile_2",
    "checks": {
      "pr": "CI",
      "main": "CI"
    },
    "pr": ["bash ./scripts/workspace-ci.sh"],
    "main": ["bash ./scripts/workspace-ci.sh"]
  },
  "tasks": {
    "test": "npm run test:node"
  }
}
